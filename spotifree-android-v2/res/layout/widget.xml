<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical" android:background="#202020" android:padding="8dp">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/track" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Spotifree" android:textColor="#FFFFFF" android:textSize="15sp" android:singleLine="true" />
        <TextView android:id="@+id/artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Open Spotify to play" android:textColor="#B0B0B0" android:textSize="12sp" android:singleLine="true" />
    </LinearLayout>
    <Button android:id="@+id/previous" android:layout_width="56dp" android:layout_height="48dp" android:text="Prev" />
    <Button android:id="@+id/play" android:layout_width="64dp" android:layout_height="48dp" android:text="Play" />
    <Button android:id="@+id/next" android:layout_width="56dp" android:layout_height="48dp" android:text="Next" />
</LinearLayout>